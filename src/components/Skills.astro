<style>
  /* ── Base Card ── */
  .skill-card {
    position: relative;
    overflow: hidden;
    cursor: default;
    -webkit-tap-highlight-color: transparent;
    transition:
      transform 0.35s ease-out,
      box-shadow 0.35s ease-out,
      border-color 0.35s ease-out;
  }

  /* ── Elegant Idle Glow (Does NOT break reveal-fade-up) ── */
  .skill-card::before {
    content: '';
    position: absolute;
    top: 10%;
    left: 50%;
    width: 60px;
    height: 60px;
    background: radial-gradient(circle, rgba(96, 165, 250, 0.2) 0%, transparent 70%);
    border-radius: 50%;
    transform: translateX(-50%) scale(0.8);
    opacity: 0;
    z-index: 0;
    pointer-events: none;
    animation: ambient-glow 5s ease-in-out infinite;
    animation-delay: var(--delay, 0ms);
  }

  @keyframes ambient-glow {
    0%, 100% { opacity: 0; transform: translateX(-50%) scale(0.8); }
    50% { opacity: 1; transform: translateX(-50%) scale(1.3); }
  }

  /* Keep icon/text above the glow layer */
  .skill-card svg,
  .skill-card p {
    position: relative;
    z-index: 1;
  }

  .skill-icon {
    transition: transform 0.35s ease-out, filter 0.35s ease-out, color 0.35s ease-out;
  }

  .skill-label {
    transition: color 0.35s ease-out, transform 0.35s ease-out;
  }

  /* ── UNIFIED HOVER/TOUCH STATE (Desktop & Mobile) ── */
  .skill-card:hover,
  .skill-card.is-touched {
    transform: translateY(-6px) scale(1.03);
    border-color: rgba(96, 165, 250, 0.35);
    box-shadow: 0 20px 40px -12px rgba(96, 165, 250, 0.15);
  }

  .skill-card:hover .skill-icon,
  .skill-card.is-touched .skill-icon {
    transform: scale(1.15);
    color: #F59E0B; /* Gold */
    filter: drop-shadow(0 0 8px rgba(245, 158, 11, 0.5));
  }

  .skill-card:hover .skill-label,
  .skill-card.is-touched .skill-label {
    transform: translateY(1px);
    color: #60A5FA; /* Blue */
  }
</style>

<section id="skills" class="py-16 px-4 md:py-24 md:px-6 lg:py-32">
  <div class="max-w-6xl mx-auto">

    <div class="text-center mb-12 md:mb-16 reveal-fade-up">
      <p class="text-accent-blue text-[10px] md:text-xs font-semibold uppercase tracking-[0.2em] mb-3 md:mb-4">Skills</p>
      <h2 class="font-heading font-bold text-2xl md:text-3xl lg:text-4xl text-text-primary">My Toolkit</h2>
    </div>

    <div class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4 lg:grid-cols-4">
      {
        skills.map((skill, i) => (
          <div
            class="glass skill-card rounded-xl md:rounded-2xl p-4 md:p-5 text-center reveal-fade-up"
            style={`--delay: ${i * 80}ms;`}
          >
            <svg
              class="skill-icon w-6 h-6 md:w-7 md:h-7 mx-auto text-accent-blue mb-2 md:mb-3"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d={skill.icon} />
            </svg>
            <p class="skill-label text-[11px] md:text-sm font-medium text-text-primary leading-tight">
              {skill.label}
            </p>
          </div>
        ))
      }
    </div>

  </div>
</section>

<script>
  // Syncs mobile tap to perfectly mimic the desktop hover effect
  document.querySelectorAll('.skill-card').forEach(card => {
    card.addEventListener('touchstart', () => {
      // Clear any other tapped cards first
      document.querySelectorAll('.skill-card.is-touched').forEach(c => c.classList.remove('is-touched'));
      // Apply the effect
      card.classList.add('is-touched');
    }, { passive: true });

    card.addEventListener('touchend', () => {
      // Small delay so the user actually sees the lift before it drops
      setTimeout(() => card.classList.remove('is-touched'), 200);
    }, { passive: true });
  });
</script>