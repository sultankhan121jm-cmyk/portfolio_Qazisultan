---
---

<section id="certifications" class="py-24 md:py-32 px-6">
  <div class="max-w-6xl mx-auto">

    <div class="text-center mb-16 reveal-fade-up">
      <p class="text-accent-blue text-xs font-semibold uppercase tracking-[0.2em] mb-4">Certifications</p>
      <h2 class="font-heading font-bold text-3xl md:text-4xl text-text-primary">Verified Credentials</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

      <!-- Meta Certification -->
      <div class="glass gold-shimmer rounded-2xl p-6 flex flex-col reveal-fade-up">
        <img
          src="/images/meta-badge.png"
          alt="Meta Certified Digital Marketing Associate badge"
          class="w-20 h-20 mx-auto mb-4 rounded-full"
          loading="lazy"
          decoding="async"
          width="80" height="80"
        />
        <h3 class="font-heading font-bold text-lg text-text-primary text-center">Meta Social Media Marketing</h3>
        <p class="text-accent-blue text-xs font-medium text-center mt-1">Meta · Coursera</p>
        <p class="text-text-muted text-xs text-center mt-1 mb-4">June 2025</p>
        <div class="flex-1">
          <p class="stat-label mb-1">Modules:</p>
          <p class="text-text-muted text-xs leading-relaxed">Social Media Mgmt · Meta Advertising · Measure &amp; Optimize · Capstone</p>
        </div>
        <a
          href="https://www.coursera.org/account/accomplishments/specialization/certificate/8Z1564X4C3PA"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex items-center justify-center gap-1.5 text-accent-blue text-sm font-medium hover:underline"
        >
          Verify
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="7" y1="17" x2="17" y2="7" /><polyline points="7 7 17 7 17 17" />
          </svg>
        </a>
      </div>

      <!-- Google Certification -->
      <div class="glass gold-shimmer rounded-2xl p-6 flex flex-col reveal-fade-up" style="--delay: 100ms;">
        <img
          src="/images/google-badge.png"
          alt="Google Digital Marketing and E-commerce certificate badge"
          class="w-20 h-20 mx-auto mb-4 rounded-full"
          loading="lazy"
          decoding="async"
          width="80" height="80"
        />
        <h3 class="font-heading font-bold text-lg text-text-primary text-center">Google Digital Marketing &amp; E-commerce</h3>
        <p class="text-accent-blue text-xs font-medium text-center mt-1">Google · Coursera</p>
        <p class="text-text-muted text-xs text-center mt-1 mb-4">March 2025</p>
        <div class="flex-1">
          <p class="stat-label mb-1">Modules:</p>
          <p class="text-text-muted text-xs leading-relaxed">Foundations · Email Marketing · Analytics · E-commerce · Customer Loyalty</p>
        </div>
        <a
          href="https://www.coursera.org/account/accomplishments/professional-cert/SHP3GZA1FR7L"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex items-center justify-center gap-1.5 text-accent-blue text-sm font-medium hover:underline"
        >
          Verify
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="7" y1="17" x2="17" y2="7" /><polyline points="7 7 17 7 17 17" />
          </svg>
        </a>
      </div>

      <!-- Peak Solutions Certification -->
      <div class="glass gold-shimmer rounded-2xl p-6 flex flex-col reveal-fade-up" style="--delay: 200ms;">
        <div class="w-20 h-20 mx-auto mb-4 rounded-full bg-accent-gold/10 border border-accent-gold/30 flex items-center justify-center" aria-hidden="true">
          <svg class="w-10 h-10 text-accent-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="7" /><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88" />
          </svg>
        </div>
        <h3 class="font-heading font-bold text-lg text-text-primary text-center">Certificate of Merit</h3>
        <p class="text-accent-blue text-xs font-medium text-center mt-1">Peak Solutions</p>
        <p class="text-text-muted text-xs text-center mt-1 mb-4">December 2025</p>
        <div class="flex-1">
          <p class="stat-label mb-1">Modules:</p>
          <p class="text-text-muted text-xs leading-relaxed">Social Media · SEO · SEM · YouTube Marketing</p>
          <div class="mt-2 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-accent-gold/10 border border-accent-gold/20">
            <span class="w-1.5 h-1.5 rounded-full bg-accent-gold" aria-hidden="true"></span>
            <span class="text-accent-gold font-medium uppercase tracking-wider" style="font-size: 0.6875rem;">12-week project-based training</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>