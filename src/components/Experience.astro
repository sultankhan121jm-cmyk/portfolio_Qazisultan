---
---

<section id="experience" class="py-24 md:py-32 px-6">
  <div class="max-w-4xl mx-auto">

    <div class="text-center mb-10 reveal-fade-up">
      <p class="text-text-subtle text-sm font-semibold uppercase tracking-[0.2em] mb-4">Experience</p>
      <h2 class="font-heading font-bold text-3xl md:text-4xl text-text-primary">Where I've Delivered Results</h2>
    </div>

    <!-- Download Documents Section -->

    <div class="relative">
      <div class="absolute left-4 md:left-1/2 md:-translate-x-px top-0 bottom-0 w-0.5 timeline-line" aria-hidden="true"></div>

      <!-- Card 1: TechnicalStars (Live Client) -->
      <div class="relative flex flex-col md:flex-row md:items-start mb-16 reveal-fade-up">
        <div class="absolute left-4 md:left-1/2 -translate-x-1/2 w-4 h-4 rounded-full bg-accent-blue border-4 border-background z-10 mt-8" aria-hidden="true"></div>

        <div class="ml-12 md:ml-0 md:w-[calc(50%-2rem)] md:pr-8">
          <div class="glass rounded-2xl p-6 md:p-8 glow-hover">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-red-500/10 border border-red-500/30 mb-4">
              <span class="w-2 h-2 rounded-full bg-red-500 pulse-red" aria-hidden="true"></span>
              <span class="text-red-400 text-sm font-semibold uppercase tracking-wider">Live Client</span>
            </div>

            <h3 class="font-heading font-bold text-xl text-text-primary">Google Search Ads Campaign Manager</h3>
            <p class="text-text-muted text-base font-medium mt-1">TechnicalStars</p>
            <p class="text-text-subtle text-sm mt-1 mb-4">Apr – May 2026</p>

            <ul class="space-y-2 text-text-muted text-base leading-relaxed" role="list">
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 mt-1 text-accent-blue flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Planned, structured, and launched a full Google Search campaign end-to-end</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 mt-1 text-accent-blue flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Achieved 8.68% CTR — exceeding the industry benchmark of 2–5% by over 3×</span>
              </li>
            </ul>

            <div class="mt-5 grid grid-cols-2 md:grid-cols-2 gap-2 md:gap-3">
              <div class="text-center p-3 rounded-xl bg-white/[0.03] border border-white/[0.06]">
                <p class="font-heading font-bold text-xl md:text-2xl text-text-primary">103</p>
                <p class="stat-label mt-1">Clicks</p>
              </div>
              <div class="text-center p-3 rounded-xl bg-white/[0.03] border border-white/[0.06]">
                <p class="font-heading font-bold text-xl md:text-2xl text-text-primary">1.19K</p>
                <p class="stat-label mt-1">Impressions</p>
              </div>
              <div class="text-center p-3 rounded-xl bg-white/[0.03] border border-white/[0.06]">
                <p class="font-heading font-bold text-xl md:text-2xl text-accent-blue">8.68%</p>
                <p class="stat-label mt-1">CTR</p>
              </div>
              <div class="text-center p-3 rounded-xl bg-white/[0.03] border border-white/[0.06]">
                <p class="font-heading font-bold text-xl md:text-2xl text-text-primary">Rs 408</p>
                <p class="stat-label mt-1">Avg CPC</p>
              </div>
            </div>

            <div class="mt-3 text-sm text-text-subtle px-1">
              <span class="text-accent-gold font-medium">↑ 3× Industry Average (2–5%)</span>
            </div>

            <div class="mt-6 space-y-4" role="group" aria-label="Campaign performance screenshots">
              <div>
                <p class="text-text-subtle text-sm mb-2 uppercase tracking-wider font-medium">Campaign Overview Dashboard</p>
                <a href="/images/campaign-overview-928.webp" target="_blank" rel="noopener noreferrer" class="block group">
                  <picture>
                    <source srcset="/images/campaign-overview-464.webp 1x, /images/campaign-overview-928.webp 2x" type="image/webp">
                    <img src="/images/campaign-overview-464.jpg" alt="Google Ads Overview Dashboard" class="w-full rounded-lg border border-white/[0.08] transition-transform duration-300 group-hover:scale-[1.02]" loading="lazy" decoding="async" width="462" height="148" />
                  </picture>
                </a>
              </div>
              <div>
                <p class="text-text-subtle text-sm mb-2 uppercase tracking-wider font-medium">Most-Shown Search Ad</p>
                <a href="/images/campaign-most-shown-ad-928.webp" target="_blank" rel="noopener noreferrer" class="block group">
                  <picture>
                    <source srcset="/images/campaign-most-shown-ad-464.webp 1x, /images/campaign-most-shown-ad-928.webp 2x" type="image/webp">
                    <img src="/images/campaign-most-shown-ad-464.jpg" alt="Most-shown Google Search Ad" class="w-full rounded-lg border border-white/[0.08] transition-transform duration-300 group-hover:scale-[1.02]" loading="lazy" decoding="async" width="462" height="476" />
                  </picture>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 2: Peak Solutions (Internship) -->
      <div class="relative flex flex-col md:flex-row md:items-start md:justify-end mb-16 reveal-fade-up" style="--delay: 100ms;">
        <div class="absolute left-4 md:left-1/2 -translate-x-1/2 w-4 h-4 rounded-full bg-text-subtle border-4 border-background z-10 mt-8" aria-hidden="true"></div>

        <div class="ml-12 md:ml-0 md:w-[calc(50%-2rem)] md:pl-8">
          <div class="glass rounded-2xl p-6 md:p-8 glow-hover">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/[0.05] border border-white/[0.1] mb-4">
              <span class="text-text-subtle text-sm font-semibold uppercase tracking-wider">Internship</span>
            </div>

            <h3 class="font-heading font-bold text-xl text-text-primary">Digital Marketing Intern</h3>
            <p class="text-text-muted text-base font-medium mt-1">Peak Solutions College, Lahore</p>
            <p class="text-text-subtle text-sm mt-1 mb-4">Sep – Dec 2025 · 3 months</p>

            <ul class="space-y-2 text-text-muted text-base leading-relaxed" role="list">
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 mt-1 text-accent-blue flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Planned and ran a YouTube brand awareness campaign from the ground up — defined target audience, ad placements, and messaging to grow brand visibility among prospective students</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 mt-1 text-accent-blue flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Set up and optimized a Google Ads lead-generation campaign using on-platform lead forms, turning ad clicks directly into enrollment inquiries</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 mt-1 text-accent-blue flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Owned creative production end-to-end in Canva and used campaign data (reach, CTR, CPC, engagement) to identify what was working and reallocate budget</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 mt-1 text-accent-gold flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                <span class="text-text-primary font-medium">Awarded Certificate of Merit on completion</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Card 3: Calla & Ivy (Meta Capstone) -->
      <div class="relative flex flex-col md:flex-row md:items-start mb-16 reveal-fade-up" style="--delay: 200ms;">
        <div class="absolute left-4 md:left-1/2 -translate-x-1/2 w-4 h-4 rounded-full bg-accent-blue border-4 border-background z-10 mt-8" aria-hidden="true"></div>

        <div class="ml-12 md:ml-0 md:w-[calc(50%-2rem)] md:pr-8">
          <div class="glass rounded-2xl p-6 md:p-8 glow-hover">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/30 mb-4">
              <span class="w-2 h-2 rounded-full bg-blue-500" aria-hidden="true"></span>
              <span class="text-blue-400 text-sm font-semibold uppercase tracking-wider">Meta Capstone Project</span>
            </div>

            <h3 class="font-heading font-bold text-xl text-text-primary">Meta Ads Campaign Strategist</h3>
            <p class="text-text-muted text-base font-medium mt-1">Calla & Ivy (E-commerce Florist)</p>
            <p class="text-text-subtle text-sm mt-1 mb-4">Nov – Dec 2020</p>

            <ul class="space-y-2 text-text-muted text-base leading-relaxed" role="list">
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 mt-1 text-accent-blue flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Designed a full-funnel Meta Ads strategy for an e-commerce brand, including audience research, segmentation, and creative planning across Facebook, Instagram, and Audience Network</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 mt-1 text-accent-blue flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Structured and executed an A/B test comparing two offers (Free Shipping vs. 10% Off) on a $50/day budget</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 mt-1 text-accent-gold flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                <span class="text-text-primary font-medium">Free Shipping outperformed: 38,780 clicks · $0.05 CPR · 1.4% CTR · 15× ROAS</span>
              </li>
            </ul>

            <div class="mt-5 grid grid-cols-2 gap-2 md:gap-3">
              <div class="text-center p-3 rounded-xl bg-white/[0.03] border border-white/[0.06]">
                <p class="font-heading font-bold text-xl md:text-2xl text-text-primary">38.7K</p>
                <p class="stat-label mt-1">Clicks</p>
              </div>
              <div class="text-center p-3 rounded-xl bg-white/[0.03] border border-white/[0.06]">
                <p class="font-heading font-bold text-xl md:text-2xl text-text-primary">$0.05</p>
                <p class="stat-label mt-1">CPR</p>
              </div>
              <div class="text-center p-3 rounded-xl bg-white/[0.03] border border-white/[0.06]">
                <p class="font-heading font-bold text-xl md:text-2xl text-text-primary">1.4%</p>
                <p class="stat-label mt-1">CTR</p>
              </div>
              <div class="text-center p-3 rounded-xl bg-white/[0.03] border border-white/[0.06]">
                <p class="font-heading font-bold text-xl md:text-2xl text-accent-blue">15x</p>
                <p class="stat-label mt-1">ROAS</p>
              </div>
              <div class="flex justify-center mt-4">
  <a href="/CallaAndlvvy.pdf" download class="inline-flex items-center gap-2 px-5 py-2 rounded-lg text-sm font-medium text-blue-400 bg-blue-500/10 border border-blue-500/20 hover:bg-blue-500/20 hover:border-blue-500/40 transition-all duration-200">
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
      <polyline points="7 10 12 15 17 10"></polyline>
      <line x1="12" y1="15" x2="12" y2="3"></line>
    </svg>
    <span>Case Study</span>
  </a>
</div>
            </div>
          </div>

          
        </div>
      </div>

    </div>
  </div>
</section>