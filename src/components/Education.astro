<section id="education" class="py-24 md:py-32 px-6">
  <div class="max-w-3xl mx-auto">

    <div class="text-center mb-12 reveal-fade-up">
      <p class="text-accent-blue text-xs font-semibold uppercase tracking-[0.2em] mb-4">Education</p>
      <h2 class="font-heading font-bold text-3xl md:text-4xl text-text-primary">Academic Background</h2>
    </div>

    <div class="glass rounded-2xl p-8 glow-hover reveal-fade-up" style="--delay: 100ms;">
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
        <div>
          <h3 class="font-heading font-bold text-xl text-text-primary">BSc Computer Science</h3>
          <p class="text-accent-blue text-sm font-medium mt-1">Government College University (GCU) Lahore</p>
          <p class="text-text-muted text-xs mt-1">
            2022 – 2026
            <span class="inline-flex items-center gap-1 ml-2 px-2 py-0.5 rounded-full bg-accent-blue/10 text-accent-blue text-[10px] font-semibold uppercase tracking-wider">In Progress</span>
          </p>
        </div>
        <div class="flex-shrink-0">
          <svg class="w-12 h-12 text-accent-blue/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
            <path d="M6 12v5c3 3 9 3 12 0v-5" />
          </svg>
        </div>
      </div>
      <div class="mt-6 pt-6 border-t border-white/[0.06]">
        <p class="text-text-muted text-sm italic leading-relaxed">
          "Rare combination of CS technical depth and hands-on marketing execution."
        </p>
      </div>
    </div>

  </div>
</section>